  "regles_nom": {
    "_doc": "Appliquées dans l'ordre, après la correspondance des anciennes catégories. 'si_cat' limite la règle aux produits dont la catégorie provisoire est dans la liste (vide = tous). La première règle qui correspond gagne.",
    "regles": [
      {"motif": "\\b(combo|ensemble liquid|embrace kit)\\b", "si_cat": ["cannes-une-main", "cannes-spey-switch"], "cat": "ensembles"},
      {"motif": "spey|switch|deux mains|two.?hand", "si_cat": ["cannes-une-main"], "cat": "cannes-spey-switch"},
      {
        "motif": "running line|shooting line|gripshooter|powerflex core|ridge 2\\.0 running",
        "si_cat": ["soies-une-main", "soies-spey", "avancons"],
