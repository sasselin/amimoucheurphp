      {"motif": "wader/duffel|wader tote|duffle|duffel|gear bag", "si_cat": ["sacs-voyage", "sacs-portes"], "cat": "sacs-voyage"},
      {"motif": "\\b(é|e)tui\\b|reel case|neoprene", "si_cat": ["moulinets-mouche"], "cat": "etuis-moulinets"},
      {"motif": "rod (&|and) reel case|rod case", "si_cat": ["sacs-voyage", "sacs-portes"], "cat": "etuis-cannes"},
      {"motif": "reel case|reel bag|étui à moulinet", "si_cat": ["sacs-voyage", "sacs-portes"], "cat": "etuis-moulinets"},
