# Derrière le Caddy d'entrée du serveur (root), qui fait le TLS et renvoie les domaines de entree.caddy ici,
# en http sur 127.0.0.1:8081. Ses en-têtes X-Forwarded-* sont repris tels quels : Apache voit HTTPS=on par
# X-Forwarded-Proto.
{
	servers {
		trusted_proxies static private_ranges
	}
}

http://www.amimoucheur.com {
	encode gzip
	request_body {
		max_size 32MB
	}
	reverse_proxy apache:80
}

http://amimoucheur.com {
	redir https://www.amimoucheur.com{uri} permanent
}

# Page de revue du catalogue pour le client (fichiers statiques, envoyés par deploy-proto.sh).
# Accès par code envoyé par courriel : proto-auth.py (liste dans /srv/amimoucheur/proto-auth/courriels.txt).
http://proto.amimoucheur.com {
	encode gzip
	header X-Robots-Tag "noindex, nofollow"
	handle /connexion* {
		reverse_proxy proto-auth:8080
	}
	handle /deconnexion {
		reverse_proxy proto-auth:8080
	}
	handle {
		forward_auth proto-auth:8080 {
			uri /verifier
		}
		root * /srv/proto
		file_server
	}
}
